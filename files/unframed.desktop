[Desktop Entry]
Name=unframed
GenericName=Image Viewer
Comment=Modern Wayland image viewer powered by Optics
Exec=unframed %F
Terminal=false
Type=Application
Categories=Graphics;2DGraphics;Viewer;
MimeType=image/png;image/jpeg;image/gif;image/webp;image/bmp;image/tiff;image/svg+xml;image/x-portable-pixmap;image/x-portable-graymap;image/x-portable-bitmap;image/x-portable-anymap;image/qoi;image/x-tga;image/vnd.microsoft.icon;image/x-farbfeld;image/x-exr;image/vnd.radiance;
Icon=multimedia-photo-viewer
Keywords=photo;picture;image;viewer;wayland;svg;ppm;
StartupNotify=true
StartupWMClass=ai.opencode.unframed
